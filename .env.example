# Shadow Tester configuration
# Copy to .env and edit as needed.

# Commune INSEE code par défaut (Manosque = 04112)
SHADOW_DEFAULT_COMMUNE=04112

# Dossier cache pour les CSV DVF téléchargés
SHADOW_CACHE_DIR=data/cache

# Chemin de la base SQLite
SHADOW_DB_PATH=data/shadow_tester.sqlite

# URL de base DVF Géo (Etalab)
SHADOW_DVF_BASE_URL=https://files.data.gouv.fr/geo-dvf/latest/csv

# Niveau de log
SHADOW_LOG_LEVEL=INFO
